<%--
  utilidades.jspf - Metodos auxiliares reutilizables en todo el proyecto.
  Se incluye siempre DESPUES de conexion.jspf.
--%>
<%@ page import="java.security.MessageDigest, java.text.NumberFormat, java.util.Locale" %>
<%!
    /** Cifra un texto con SHA-256 y lo devuelve en hexadecimal. */
    public String sha256(String texto) {
        try {
            MessageDigest md = MessageDigest.getInstance("SHA-256");
            byte[] resumen = md.digest(texto.getBytes("UTF-8"));
            StringBuilder sb = new StringBuilder();
            for (byte b : resumen) sb.append(String.format("%02x", b));
            return sb.toString();
        } catch (Exception ex) {
            throw new RuntimeException("Error al cifrar la clave", ex);
        }
    }

    /** Combina username y clave antes de cifrar: dos usuarios con la misma
     *  clave producen hashes distintos (salt sencillo). */
    public String claveCifrada(String username, String clave) {
        return sha256(username + ":" + clave);
    }

    /** Formatea un valor como moneda colombiana: 15000000 -> $ 15.000.000 */
    public String pesos(double valor) {
        NumberFormat f = NumberFormat.getInstance(new Locale("es", "CO"));
        f.setMaximumFractionDigits(0);
        return "$ " + f.format(valor);
    }

    public int aEntero(String valor, int porDefecto) {
        try { return Integer.parseInt(valor.trim()); }
        catch (Exception ex) { return porDefecto; }
    }

    public double aDoble(String valor, double porDefecto) {
        try { return Double.parseDouble(valor.trim().replace(",", ".")); }
        catch (Exception ex) { return porDefecto; }
    }

    /** Escapa caracteres HTML para evitar XSS al mostrar datos escritos por el usuario. */
    public String esc(String texto) {
        if (texto == null) return "";
        return texto.replace("&", "&amp;").replace("<", "&lt;")
                    .replace(">", "&gt;").replace("\"", "&quot;");
    }

    /** Traduce las violaciones de restriccion UNIQUE a un mensaje entendible.
     *  Cubre las cuatro UNIQUE de usuario y las de propiedad/cita. */
    public String mensajeError(java.sql.SQLException ex) {
        String m = ex.getMessage() == null ? "" : ex.getMessage();
        if (m.contains("usuario.correo") || m.contains("correo"))
            return "Ese correo ya esta registrado.";
        if (m.contains("usuario.documento") || m.contains("documento"))
            return "Ese numero de documento ya esta registrado.";
        if (m.contains("usuario.username") || m.contains("username"))
            return "Ese nombre de usuario ya esta en uso.";
        if (m.contains("matricula_inmobiliaria"))
            return "Ya existe una propiedad con esa matricula inmobiliaria.";
        if (m.contains("uq_cita_propiedad_fecha"))
            return "Esa propiedad ya tiene una cita agendada en ese horario.";
        if (m.contains("PRIMARY") && m.contains("usuario_rol"))
            return "El usuario ya tiene ese rol asignado.";
        return "Error de base de datos: " + m;
    }
%>
<%@ page pageEncoding="UTF-8" %>
<%--
  cabecera.jspf - Encabezado + sidebar de los paneles internos.
  Requiere que la pagina ya haya incluido seguridad.jspf antes
  (usa rolSesion, nombreSesion, ctx) y que declare "tituloPagina".
--%>
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= tituloPagina %> | Raíz</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link rel="stylesheet" href="<%= ctx %>/css/style.css">
<link rel="stylesheet" href="<%= ctx %>/css/panel.css">
</head>
<body class="panel-body">
<div class="panel-shell">
  <aside class="panel-sidebar">
    <a class="brand" href="<%= ctx %>/index.jsp">Ra<span>í</span>z</a>
    <nav class="panel-nav">
      <a href="<%= ctx %>/index.jsp"><i class="bi bi-house"></i> Página principal</a>
      <a href="<%= ctx %>/propiedades/listado.jsp"><i class="bi bi-search"></i> Buscar propiedades</a>
      <a href="<%= ctx %>/perfil.jsp"><i class="bi bi-person"></i> Mi perfil</a>
      <% if ("CLIENTE".equals(rolSesion) || "ADMINISTRADOR".equals(rolSesion)) { %>
        <a href="<%= ctx %>/cliente/panel.jsp"><i class="bi bi-grid"></i> Mi panel</a>
        <a href="<%= ctx %>/cliente/mis_citas.jsp"><i class="bi bi-calendar-check"></i> Mis citas</a>
        <a href="<%= ctx %>/cliente/mis_solicitudes.jsp"><i class="bi bi-file-earmark-text"></i> Mis solicitudes</a>
        <a href="<%= ctx %>/cliente/mis_favoritos.jsp"><i class="bi bi-heart"></i> Mis favoritos</a>
      <% } %>
      <% if ("INMOBILIARIA".equals(rolSesion) || "ADMINISTRADOR".equals(rolSesion)) { %>
        <a href="<%= ctx %>/inmobiliaria/propiedades.jsp"><i class="bi bi-buildings"></i> Mis propiedades</a>
        <a href="<%= ctx %>/inmobiliaria/citas.jsp"><i class="bi bi-calendar-week"></i> Citas recibidas</a>
        <a href="<%= ctx %>/inmobiliaria/solicitudes.jsp"><i class="bi bi-inboxes"></i> Solicitudes recibidas</a>
      <% } %>
      <% if ("ADMINISTRADOR".equals(rolSesion) || "INMOBILIARIA".equals(rolSesion)) { %>
        <a href="<%= ctx %>/reportes.jsp"><i class="bi bi-bar-chart"></i> Reportes</a>
      <% } %>
      <% if ("ADMINISTRADOR".equals(rolSesion)) { %>
        <a href="<%= ctx %>/admin/panel.jsp"><i class="bi bi-gear"></i> Administración</a>
      <% } %>
    </nav>
    <div class="panel-user">
      <p><%= esc(nombreSesion) %></p>
      <span class="badge"><%= rolSesion %></span>
      <a href="<%= ctx %>/logout.jsp" class="panel-logout"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</a>
    </div>
  </aside>
  <main class="panel-main">

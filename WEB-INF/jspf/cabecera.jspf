<%@ page pageEncoding="UTF-8" %>
<%--
  cabecera.jspf - Encabezado + sidebar de los paneles internos.
  Requiere que la pagina ya haya incluido seguridad.jspf antes
  (usa rolSesion, rolesSesion, nombreSesion, ctx) y que declare "tituloPagina".
  El menu se arma contra rolesSesion (lista completa) y no contra rolSesion
  (el rol "principal"), para que un usuario con varios roles N:M vea todas
  las opciones a las que tiene acceso.
--%>
<%@ page import="java.sql.*" %>
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= tituloPagina %> | Raíz</title>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link rel="stylesheet" href="<%= ctx %>/css/style.css">
<link rel="stylesheet" href="<%= ctx %>/css/panel.css">
</head>
<body class="panel-body">
<%
    // Ruta de la pagina actual (sin context path), para marcar el link
    // del sidebar que corresponde con la clase "active".
    String rutaActual = request.getServletPath();

    // Foto de perfil (perfil.foto) para el avatar del sidebar; si falla la
    // consulta o el campo esta vacio, se cae al avatar con la inicial.
    String fotoSidebar = null;
    try {
        Connection conAvatar = abrirConexion();
        PreparedStatement psAvatar = conAvatar.prepareStatement(
            "SELECT foto FROM perfil WHERE id_usuario = ?");
        psAvatar.setInt(1, idUsuarioSesion);
        ResultSet rsAvatar = psAvatar.executeQuery();
        if (rsAvatar.next()) fotoSidebar = rsAvatar.getString("foto");
        cerrar(rsAvatar, psAvatar, conAvatar);
    } catch (SQLException ex) { /* se usa el fallback de inicial */ }
    String inicialSidebar = (nombreSesion != null && !nombreSesion.trim().isEmpty())
        ? nombreSesion.trim().substring(0, 1).toUpperCase() : "?";
%>
<div class="panel-shell">
  <aside class="panel-sidebar">
    <a class="brand" href="<%= ctx %>/index.jsp">Ra<span>í</span>z</a>
    <nav class="panel-nav">
      <a class="<%= rutaActual.equals("/index.jsp") ? "active" : "" %>" href="<%= ctx %>/index.jsp"><i class="bi bi-house"></i> Página principal</a>
      <a class="<%= rutaActual.startsWith("/propiedades/") ? "active" : "" %>" href="<%= ctx %>/propiedades/listado.jsp"><i class="bi bi-search"></i> Buscar propiedades</a>
      <a class="<%= rutaActual.equals("/perfil.jsp") ? "active" : "" %>" href="<%= ctx %>/perfil.jsp"><i class="bi bi-person"></i> Mi perfil</a>
      <% if (rolesSesion.contains("CLIENTE")) { %>
        <a class="<%= rutaActual.equals("/cliente/panel.jsp") ? "active" : "" %>" href="<%= ctx %>/cliente/panel.jsp"><i class="bi bi-grid"></i> Mi panel</a>
        <a class="<%= rutaActual.equals("/cliente/mis_citas.jsp") ? "active" : "" %>" href="<%= ctx %>/cliente/mis_citas.jsp"><i class="bi bi-calendar-check"></i> Mis citas</a>
        <a class="<%= rutaActual.equals("/cliente/mis_solicitudes.jsp") ? "active" : "" %>" href="<%= ctx %>/cliente/mis_solicitudes.jsp"><i class="bi bi-file-earmark-text"></i> Mis solicitudes</a>
        <a class="<%= rutaActual.equals("/cliente/mis_favoritos.jsp") ? "active" : "" %>" href="<%= ctx %>/cliente/mis_favoritos.jsp"><i class="bi bi-heart"></i> Mis favoritos</a>
      <% } %>
      <% if (rolesSesion.contains("INMOBILIARIA")) { %>
        <a class="<%= rutaActual.equals("/inmobiliaria/panel.jsp") ? "active" : "" %>" href="<%= ctx %>/inmobiliaria/panel.jsp"><i class="bi bi-grid"></i> Mi panel</a>
        <a class="<%= rutaActual.equals("/inmobiliaria/propiedades.jsp") ? "active" : "" %>" href="<%= ctx %>/inmobiliaria/propiedades.jsp"><i class="bi bi-buildings"></i> Mis propiedades</a>
        <a class="<%= rutaActual.equals("/inmobiliaria/citas.jsp") ? "active" : "" %>" href="<%= ctx %>/inmobiliaria/citas.jsp"><i class="bi bi-calendar-week"></i> Citas recibidas</a>
        <a class="<%= rutaActual.equals("/inmobiliaria/solicitudes.jsp") ? "active" : "" %>" href="<%= ctx %>/inmobiliaria/solicitudes.jsp"><i class="bi bi-inboxes"></i> Solicitudes recibidas</a>
      <% } %>
      <% if (rolesSesion.contains("ADMINISTRADOR") || rolesSesion.contains("INMOBILIARIA")) { %>
        <a class="<%= rutaActual.equals("/reportes.jsp") ? "active" : "" %>" href="<%= ctx %>/reportes.jsp"><i class="bi bi-bar-chart"></i> Reportes</a>
      <% } %>
      <% if (rolesSesion.contains("ADMINISTRADOR")) { %>
        <a class="<%= rutaActual.equals("/admin/panel.jsp") ? "active" : "" %>" href="<%= ctx %>/admin/panel.jsp"><i class="bi bi-gear"></i> Administración</a>
        <a class="<%= rutaActual.equals("/admin/usuarios.jsp") ? "active" : "" %>" href="<%= ctx %>/admin/usuarios.jsp"><i class="bi bi-people"></i> Usuarios</a>
        <a class="<%= rutaActual.equals("/admin/catalogos.jsp") ? "active" : "" %>" href="<%= ctx %>/admin/catalogos.jsp"><i class="bi bi-tags"></i> Catálogos</a>
        <a class="<%= rutaActual.equals("/admin/auditoria.jsp") ? "active" : "" %>" href="<%= ctx %>/admin/auditoria.jsp"><i class="bi bi-clipboard-data"></i> Auditoría</a>
      <% } %>
    </nav>
    <div class="panel-user">
<% if (fotoSidebar != null && !fotoSidebar.trim().isEmpty()) { %>
      <img class="panel-user-avatar" src="<%= esc(fotoSidebar) %>" alt="Foto de perfil">
<% } else { %>
      <span class="panel-user-avatar panel-user-avatar-fallback"><%= inicialSidebar %></span>
<% } %>
      <p><%= esc(nombreSesion) %></p>
      <span class="badge"><%= rolSesion %></span>
      <a href="<%= ctx %>/logout.jsp" class="panel-logout"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</a>
    </div>
  </aside>
  <main class="panel-main">

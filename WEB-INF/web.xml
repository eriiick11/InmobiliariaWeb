<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.xml - Descriptor de despliegue de InmobiliariaWeb.
  Version 3.1 = Java EE 7, compatible con Tomcat 8.5 (javax.servlet).
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>InmobiliariaWeb</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- La sesion caduca a los 30 minutos de inactividad -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Fuerza UTF-8 en todas las paginas JSP, aunque alguna olvide el page directive -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <url-pattern>*.jspf</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <trim-directive-whitespaces>true</trim-directive-whitespaces>
        </jsp-property-group>
    </jsp-config>

    <!-- Si alguien escribe una URL que no existe, o intenta entrar sin permiso -->
    <error-page>
        <error-code>404</error-code>
        <location>/acceso-denegado.jsp</location>
    </error-page>

    <!-- subir_documento.jsp y acciones_propiedad.jsp se registran como servlet
         (via jsp-file) SOLO para poder declararles multipart-config y leer
         archivos reales con request.getPart(), sin escribir un Servlet .java -->
    <servlet>
        <servlet-name>SubirDocumento</servlet-name>
        <jsp-file>/cliente/subir_documento.jsp</jsp-file>
        <multipart-config>
            <max-file-size>5242880</max-file-size>
            <max-request-size>10485760</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>SubirDocumento</servlet-name>
        <url-pattern>/cliente/subir_documento.jsp</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AccionesPropiedad</servlet-name>
        <jsp-file>/inmobiliaria/acciones_propiedad.jsp</jsp-file>
        <multipart-config>
            <max-file-size>5242880</max-file-size>
            <max-request-size>10485760</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>AccionesPropiedad</servlet-name>
        <url-pattern>/inmobiliaria/acciones_propiedad.jsp</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GuardarPerfil</servlet-name>
        <jsp-file>/guardar_perfil.jsp</jsp-file>
        <multipart-config>
            <max-file-size>5242880</max-file-size>
            <max-request-size>10485760</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>GuardarPerfil</servlet-name>
        <url-pattern>/guardar_perfil.jsp</url-pattern>
    </servlet-mapping>

</web-app>
